import { Button, VerticalBox } from "std-widgets.slint";

export component MainWindow inherits Window {
    title: "Noctua";
    width: 800px;
    height: 600px;

    callback abrir-pdf();

    in-out property <string> estado: "";

    VerticalBox {
        padding: 24px;
        spacing: 12px;

        Text {
            text: "Noctua";
            font-size: 32px;
        }

        Text {
            text: "Lector de documentos PDF";
        }

        Button {
            text: "Abrir PDF";
            clicked => { root.abrir-pdf(); }
        }

        Text {
            text: root.estado;
            wrap: word-wrap;
        }
    }
}